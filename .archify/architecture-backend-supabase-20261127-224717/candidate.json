    { "dot": "cyan", "title": "Ownership", "items": ["Render runs the Express app: both summarizers and all 3 upload routes", "Supabase owns persistence: Postgres, the private bucket, and the cleanup function", "Groq is the only external LLM dependency, same model for both summarizers"] },
    { "dot": "rose", "title": "Security posture", "items": ["RLS enabled + forced on all 3 tables, zero policies (default-deny)", "Only the service_role key (backend + Edge Function) bypasses RLS", "meeting-documents bucket is private; no public policy exists"] },
    { "dot": "emerald", "title": "Operational notes", "items": ["Supabase client is created lazily so missing config can't crash /api/summarize", "Cleanup cron's HTTP timeout was raised to 15s after a cold-start timeout at the 5s default", "Cleanup runs on a schedule, independent of whether any client is still open"] }
